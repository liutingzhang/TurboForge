!.env.example
.assistant-config-*
*.key
*.pem
*.pfx
secrets.*
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Documentation and delivery notes stay out of the source repo.
# The three AI_ASSISTANT_*.md files are build inputs for
# scripts/build_assistant_knowledge.py, which CI runs with --check, so they
# must remain tracked; every other file under docs/ is excluded.
docs/*
!docs/AI_ASSISTANT_KNOWLEDGE.md
!docs/AI_ASSISTANT_DIAGNOSTICS.md
!docs/AI_ASSISTANT_FIELDS.md
/PROJECT_SUMMARY.md
/CHANGELOG.md
/CONTRIBUTING.md
/SECURITY.md
/web/README.md
