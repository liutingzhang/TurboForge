# In-page AI assistant configuration template: copy to .env and fill in; never commit .env to Git.
# Read by the backend only; do not add a VITE_ prefix. Precedence: environment variables > .env > defaults.
# Values may be unquoted or double-quoted; multiline values and $variable expansion are not supported.

# Enable the assistant; default true.
TURBOFORGE_AI_ENABLED=true

# API base URL up to /v1; public networks must use https.
TURBOFORGE_AI_BASE_URL=https://llm.example.com/v1

# Model ID provided by the service provider.
TURBOFORGE_AI_MODEL=your-model-id

# API key; store it only in the local .env. Leave empty for no key.
TURBOFORGE_AI_API_KEY=

# bearer (default) or none; none requires an empty key and is restricted to the local allowlist.
TURBOFORGE_AI_AUTH_MODE=bearer

# Streaming responses; default true.
TURBOFORGE_AI_STREAM=true

# Context tokens, range 256-1048576, default 8192.
TURBOFORGE_AI_CONTEXT_TOKENS=8192

# Max output tokens, range 16-32768, default 1024; must be smaller than the context.
TURBOFORGE_AI_MAX_OUTPUT_TOKENS=1024

# Request timeout in seconds, range 5-300, default 90.
TURBOFORGE_AI_TIMEOUT_SECONDS=90

# Allow the web page to save configuration to .env; default false.
TURBOFORGE_AI_ALLOW_UI_PERSIST=false

# Local service allowlist: comma-separated exact origins; empty forbids local/private networks.
# The default port of the local model API is taken from the first origin here; change only this line to switch ports.
TURBOFORGE_AI_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:18080
