# 页内 AI 助手配置模板：复制为 .env 后填写；.env 不要提交 Git。
# 仅后端读取，禁止加 VITE_ 前缀。优先级：环境变量 > .env > 默认值。
# 值可不加引号或用双引号；不支持多行和 $变量 展开。

# 启用助手，默认 true。
TURBOFORGE_AI_ENABLED=true

# 接口根地址写到 /v1；公网必须 https。
TURBOFORGE_AI_BASE_URL=https://llm.example.com/v1

# 服务商提供的模型 ID。
TURBOFORGE_AI_MODEL=your-model-id

# API Key，只写进本机 .env；留空表示无 Key。
TURBOFORGE_AI_API_KEY=

# bearer（默认）或 none；none 需清空 Key，且仅限本机白名单。
TURBOFORGE_AI_AUTH_MODE=bearer

# 流式返回，默认 true。
TURBOFORGE_AI_STREAM=true

# 上下文 token，范围 256–1048576，默认 8192。
TURBOFORGE_AI_CONTEXT_TOKENS=8192

# 最大输出 token，范围 16–32768，默认 1024；必须小于上下文。
TURBOFORGE_AI_MAX_OUTPUT_TOKENS=1024

# 请求超时秒数，范围 5–300，默认 90。
TURBOFORGE_AI_TIMEOUT_SECONDS=90

# 允许网页把配置保存到 .env，默认 false。
TURBOFORGE_AI_ALLOW_UI_PERSIST=false

# 本机服务白名单，逗号分隔精确 origin；留空禁止本机/私网。
# 本机模型服务的默认端口取这里第一个 origin 的端口；要换端口只改这一行。
TURBOFORGE_AI_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:18080
